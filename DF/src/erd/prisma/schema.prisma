datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas = ["ct309_ag001", "ct309_a001"]
}

generator client {
provider = "prisma-client-js"
previewFeatures = ["multiSchema"]
}

model userable {
id  Int @id @default(autoincrement())
name  String? 
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?

@@schema("ct309_a001")
}

model lockdetails {
id  Int @id @default(autoincrement())
lockedby  String? 
mode  String? 
status  String? 
expires  String? 
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?

@@schema("ct309_a001")
}







