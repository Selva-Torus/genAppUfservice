datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
provider = "prisma-client-js"
}
model tof_lfi {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  lfi    TOF_LFI_Bank_Insu? 

  trs_creator_email    String?       
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?       
  trs_status    String?       
  trs_next_status    String?  
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
 

  @@map("ct242_tpptest002.tof_lfi")
  
}
model tof_tpp {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  tpp    TOF_TPP_TPP? 

  trs_creator_email    String?       
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?       
  trs_status    String?       
  trs_next_status    String?  
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
 

  @@map("ct242_tpptest002.tof_tpp")
  
}
model tof_consents {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  lfi    TOF_CONSENTS_LFI? 

  trs_creator_email    String?       
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?       
  trs_status    String?       
  trs_next_status    String?  
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
 

  @@map("ct242_tpptest002.tof_consents")
  
}
model tof_consent_request {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  type    String        
  consent    TOF_REQUEST_CONSENT? 
  subscription    TOF_SUBSCRIPTION? 

  trs_creator_email    String?       
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?       
  trs_status    String?       
  trs_next_status    String?  
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
 

  @@map("ct242_tpptest002.tof_consent_request")
  
}
model tof_consent_response {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  data    TOF_RESPONSE_DATA 

  trs_creator_email    String?       
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?       
  trs_status    String?       
  trs_next_status    String?  
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
 

  @@map("ct242_tpptest002.tof_consent_response")
  
}
