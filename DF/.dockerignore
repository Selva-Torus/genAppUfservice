# Dependencies — must be excluded so host node_modules
# never clobbers the client generated by `prisma generate` in-image
node_modules
**/node_modules
 
# Build output — regenerated by `npm run build`
dist
 
# Env / secrets
# You COPY .env explicitly in the Dockerfile, so it must stay available.
# Ignore any other env variants, keep .env itself:
.env.*
!.env
 
# Version control
.git
.gitignore
 
# CI / deploy / Docker — not needed inside the image
Dockerfile
.dockerignore
Jenkinsfile
kubernetes
 
# Docs
README.md
 
# Lint / format config — not needed at build time
.eslintrc.js
.prettierrc
 
# Logs
*.log
npm-debug.log*
 
# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
 
# Caches
.eslintcache